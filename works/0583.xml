  <text>

    <body>
      <div type="edition" xml:lang="gez">

        

        <div type="textpart" xml:id="malke">
          
          <lg type="stanza" n="1">
            
            <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘሀሎ፡ ወይሄሉ፨</l>
            <l n="2">ምስለ፡ ስመ፡ አብ፡ ግሁሠ፡ እምኍልቈ፡ አዝማናት፡ ኵሉ፨</l>
            <l n="3">ውዳሴ፡ ገድልከ፡ እንብብ፡ መልክአ፡ ክርስቶስ፡ ቃሉ፨</l>
            <l n="4">ልሳናተ፡ እሳት፡ እለ፡ ቅድመ፡ አርዳእ፡ ተከፍሉ፨</l>
            <l n="5">ይትጋብኡ፡ ላዕሌየ፡ በመስፈርት፡ ዘይደሉ፨</l>

          </lg>
          
          <lg type="stanza" n="2">
            
            <l n="1">ሰላም፡ ለሥዕርተ፡ ርእስከ፡ ወለርእስከ፡ ወትረ፨</l>
            <l n="2">ሐፈ፡ ጻማ፡ ሰጊድ፡ ዕፍረተ፡ እለ፡ ተቀብዑ፡ ኅቡረ፨</l>
            <l n="3">መልክአ፡ ክርስቶስ፡ ዋሕድ፡ ዘጣዕመ፡ ምንታዌ፡ አምረረ፨</l>
            <l n="4">አሰረ፡ መስቀልከ፡ ይትሉ፡ እግዚኦ፡ እመ፡ ልብየ፡ ኢሠምረ፨</l>
            <l n="5">ሐብለ፡ ርኅራኄ፡ አብ፡ ኢትምትር፡ እምወልድከ፡ ምዕረ፨</l>

          </lg>
          
          <lg type="stanza" n="31">
            
            <l n="1">ሰላም፡ ለርደትከ፡ በነፍስ፡ ወሥጋ፨</l>
            <l n="2">ኀበ፡ ተደለወ፡ ለከ፡ መቃብረ፡ አበው፡ ጸጋ፨</l>
            <l n="3">መልክአ፡ ክርስቶስ፡ ዘትሰብር፡ ለጌጋይ፡ ጽንዐ፡ መንሠጋ፨</l>
            <l n="4">ለደብርከሰ፡ ርስተ፡ ኅሩያን፡ እንግልጋ፨</l>
            <l n="5">ቀሊል፡ ሥርዐታ፡ ወሠናይ፡ ሕጋ፨</l>

          </lg>
          
          <lg type="stanza" n="32">
            
            <l n="1">ሰላም፡ ለፍልሰተ፡ ሥጋከ፡ ትእምርተ፡ ሐዳስ፡ ትንሣኤ፨</l>
            <l n="2">እምክብር፡ ውስተ፡ ክብር፡ በሥምረተ፡ ቅድስት፡ ጉባኤ፨</l>
            <l n="3">መልክአ፡ ክርስቶስ፡ ዋሕድ፡ ዘተጋብአ፡ እምክልኤ፨</l>
            <l n="4">ስመከ፡ በተአምኖ፡ ለእለ፡ ሠምሩ፡ ጽዋዔ፨</l>
            <l n="5">በበ፡ መሥፈርቶሙ፡ ጸጉ፡ እምሀብታት፡ ሱባዔ፨</l>

          </lg>
          
          <lg type="stanza" n="33">
            
            <l n="1">አኮ፡ ሊተ፡ ላዕልዐ፡ ልሳን፡ ወአፍ፨</l>
            <l n="2">ማሕሌተ፡ ጽድቅከ፡ እንብብ፡ መልክአ፡ ክርስቶስ፡ ትሩፍ፨</l>
            <l n="3">እመ፡ ተጋብኡ፡ ጥቀ፡ ኀይላተ፡ ሰማይ፡ አእላፍ፨</l>
            <l n="4">ለኀይለ፡ ገድልከ፡ ሕትመት፡ ኰለንታ፡ መጽሐፍ፨</l>
            <l n="5">እምኢክህሉ፡ ይክስትዋ፡ በጻማ፡ ወሐፍ፨</l>

          </lg>
          
          <lg type="stanza" n="34">
            
            <l n="1">ውዳሴ፡ ብዙኅ፡ ገድልከ፡ ለዘኢያብጽሐ፡ ቃሉ፨</l>
            <l n="2">ሥርየተ፡ ንጽሕ፡ ለተሀብ፡ ሎቱ፡ ይደሉ፨</l>
            <l n="3">መልክአ፡ ክርስቶስ፡ ለአብ፡ ኅቡእ፡ አምሳሉ፨</l>
            <l n="4">ውዳሴ፡ ገድልከ፡ ነባብያነ፡ ምድር፡ ኵሉ፨</l>
            <l n="5">እመ፡ ተጋብኡ፡ ፈጽሞ፡ ኢይክሉ፨</l>

          </lg>
          
          <lg type="stanza" n="35">
            
            <l n="1">ስብሐተ፡ ማሕሌት፡ ወርቅ፡ እመ፡ ቅድሜከ፡ ክዕው፨</l>
            <l n="2">ወዝማሬ፡ ጻድቃን፡ ባሕርይ፡ ለዕበይከ፡ ፍንው፨</l>
            <l n="3">እንዘ፡ ኢትሜንን፡ አብ፡ መልክአ፡ ክርስቶስ፡ ሕያው፨</l>
            <l n="4">ጸሪቀ፡ መበለት፡ ትትወከፍ፡ አምኃ፡ ስብሐተ፡ ጊጉያን፡ አኃው፨</l>
            <l n="5">ርቱዕ፡ ለከ፡ ወለከ፡ መፍትው፨</l>

          </lg>
          
        </div>

        <div type="textpart" xml:id="tarafa-malke">
          
          <lg type="stanza" n="1">
            
            <l n="1">ሰላም፡ ለከ፡ አበ፡ ጽዕዳዋን፡ አርጋብ፡ መልክአ፡ ክርስቶስ፡ እንጦኒ፨</l>
            <l n="2">ወመፍቀሬ፡ ኅድአት፡ ለሊከ፡ ቢጸ፡ አርሳኒ፨</l>
            <l n="3">ዘተፈቅረ፡ ቅድመ፡ መድኃኒ፨</l>

          </lg>
          
          <lg type="stanza" n="6">
            
            <l n="1">ሰላም፡ ለከ፡ ትእዛዘከ፡ አቡነ፡ አራዊተ፡ ገዳም፡ ሰምዑ፨</l>
            <l n="2">ጻማ፡ ደቂቅከ፡ እክለ፡ ከመ፡ ኢይብልዑ፨</l>
            <l n="3">ለክርስቶስ፡ ሥነ፡ መልክኡ፨</l>

          </lg>
          
          <lg type="stanza" n="7">
            
            <l n="1">ሰላም፡ ለከ፡ መካነ፡ ዕበድ፡ ለብየ፡ አእምሮ፡ መንፈስ፡ ዘአልቦ፨</l>
            <l n="2">ፍቅረከ፡ ዘንተ፡ እስመ፡ አንበቦ፨</l>
            <l n="3">መልክአ፡ ክርስቶስ፡ ጸዋሬ፡ ጸልቦ፨</l>
            <l n="4">አብጽሐኒ፡ ንስሓ፡ ኀበ፡ ቦ፨</l>

          </lg>
          
        </div>
        
      </div>
    </body>
    
