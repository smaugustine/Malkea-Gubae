  <text>

    <body>
      <div type="edition" xml:lang="gez">

        

        <div type="textpart" xml:id="malke">
          
          <lg type="stanza" n="1">
            
            <l n="1">ይነግር፡ አፉየ፡ ወልሳንየ፡ ክሡተ፨</l>
            <l n="2">ጰራቅሊጦስ፡ ፀሓይ፡ ምሉአ፡ አርያም፡ ስብሐተ፨</l>
            <l n="3">ናሁ፡ ወጠንኩ፡ በስመ፡ ሥላሴ፡ አስማተ፨</l>
            <l n="4">በአስተሐምሞ፡ ወጻህቅ፡ እንዘ፡ እብል፡ ሊተ፨</l>
            <l n="5">ወጣኒ፡ ወፈጻሚ፡ አንተ፨</l>

          </lg>
          
          <lg type="stanza" n="2">
            
            <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ እምቅድመ፡ ዓለማት፡ ዘነበረ፨</l>
            <l n="2">ወእምቅድመ፡ ትፍጥሮ፡ ለገጸ፡ ሰማይ፡ ምዕረ፨</l>
            <l n="3">ጰራቅሊጦስ፡ ህልው፡ ምስለ፡ ወላዴ፡ ወልድ፡ ኅቡረ፨</l>
            <l n="4">ለነፍሰ፡ ዚአየ፡ ጸግዋ፡ ማኅደረ፨</l>
            <l n="5">ምስለ፡ ጻድቃኒከ፡ ዘመነኑ፡ ምድረ፨</l>

          </lg>
          
          <lg type="stanza" n="3">
            
            <l n="1">ሰላም፡ ለሥዕርተ፡ ርእስከ፡ ወለርእስከ፡ ጸዐዳ፨</l>
            <l n="2">ለጸሎተ፡ ጻድቃን፡ መዝሙር፡ ዘአተዋደዳ፨</l>
            <l n="3">ጰራቅሊጦስ፡ ስቡሕ፡ ዘኢትለብስ፡ ሜላተ፡ ጋዳ፨</l>
            <l n="4">እሳተ፡ ፍቅርከ፡ እስመ፡ ለነፍስየ፡ አንደዳ፨</l>
            <l n="5">ተዘከራ፡ እግዚኦ፡ ለጽዮን፡ በዐውዳ፨</l>

          </lg>
          
          <lg type="stanza" n="4">
            
            <l n="1">ሰላም፡ ለገጽከ፡ ዘይበርህ፡ እምፀሓይ፨</l>
            <l n="2">ወለቀራንብቲከ፡ ሰላም፡ ዘኵለንታሁ፡ ሠናይ፨</l>
            <l n="3">ጰራቅሊጦስ፡ እኵት፡ ዘትሴሰይ፡ እክለ፡ ግናይ፨</l>
            <l n="4">ስደኒ፡ ውስተ፡ ቤትከ፡ ወማኅደርከ፡ ሰማይ፨</l>
            <l n="5">ዘተሐንጸት፡ በብሩር፡ ወንጹሕ፡ ባሕርይ፨</l>

          </lg>
          
          <lg type="stanza" n="5">
            
            <l n="1">ሰላም፡ ለአዕይንቲከ፡ ዘኢይኬልሎን፡ አድባራት፨</l>
            <l n="2">ለነጽሮ፡ ኵሉ፡ ፍጥረት፨</l>
            <l n="3">ጰራቅሊጦስ፡ አንተ፡ ሐዋፄ፡ ጻድቃን፡ ዘእምኔት፨</l>
            <l n="4">ዘመፍህ፡ ዐይኑ፡ ለመልአከ፡ ሞት፨</l>
            <l n="5">ወገጹ፡ ዘፍጹም፡ ጽልመት፨</l>

          </lg>
          
          <lg type="stanza" n="6">
            
            <l n="1">ሰላም፡ ለአእዛኒከ፡ ጸሎተ፡ ቅዱሳን፡ ምሉእ፨</l>
            <l n="2">ወለመላትሒከ፡ ሰላም፡ ዘመዐዛሁ፡ ጽጌ፡ ከርካዕ፨</l>
            <l n="3">ጰራቅሊጦስ፡ ጥንት፡ ለዓለመ፡ ኵሉ፡ እግዚእ፨</l>
            <l n="4">አስተበቍዐከ፡ ለዕለተ፡ ተሐውኮ፡ ወጸብዕ፨</l>
            <l n="5">ከመ፡ ታድኅነኒ፡ እምአርዌ፡ ጽኑዕ፨</l>

          </lg>
          
          <lg type="stanza" n="7">
            
            <l n="1">ሰላም፡ ለአእናፊከ፡ መዐዛ፡ ቅዳሴ፡ ዘይጼኑ፨</l>
            <l n="2">ወለከናፍሪከ፡ ሰላም፡ ዘኢይትረከብ፡ መጠኑ፨</l>
            <l n="3">ጰራቅሊጦስ፡ ፀሓይ፡ ለዓለም፡ ብርሃኑ፨</l>
            <l n="4">አብርህ፡ ዐይነ፡ ልብየ፡ ውዳሴከ፡ እዜኑ፨</l>
            <l n="5">እስመ፡ እምጸጋከ፡ ላዕሌየ፡ እምኀቤከ፡ ፈኑ፨</l>

          </lg>
          
          <lg type="stanza" n="8">
            
            <l n="1">ሰላም፡ ለአፉከ፡ አፈወ፡ መለኮት፡ ሕያው፨</l>
            <l n="2">ወለአስናኒከ፡ ሰላም፡ እምሐሊበ፡ ዕጐልት፡ ጽዕድው፨</l>
            <l n="3">ጰራቅሊጦስ፡ ዕፍረት፡ ወጰራቅሊጦስ፡ አፈው፨</l>
            <l n="4">ቀስም፡ ልሳንየ፡ በሥነ፡ መለኮት፡ ጼው፨</l>
            <l n="5">ከመ፡ ቀሰምክሙ፡ ለአርድእት፡ አበው፨</l>

          </lg>
          
          <lg type="stanza" n="9">
            
            <l n="1">ሰላም፡ ለልሳንከ፡ ለሐዋርያት፡ ዘአንበበ፨</l>
            <l n="2">ወለቃልከ፡ ሰላም፡ እምቃለ፡ ኢየሱስ፡ ተውህበ፨</l>
            <l n="3">ጰራቅሊጦስ፡ ንጹሕ፡ ዘትመሰል፡ ርግበ፨</l>
            <l n="4">በዮርዳኖስ፡ አብ፡ ወበታቦር፡ ካዕበ፨</l>
            <l n="5">እንዘ፡ ይብል፡ ሰምዕዎ፡ ጸውዐ፡ አሕዛበ፨</l>

          </lg>
          
          <lg type="stanza" n="10">
            
            <l n="1">ሰላም፡ ለእስትንፋስከ፡ እስትንፋሰ፡ አበው፡ ውእቱ፨</l>
            <l n="2">ወለጕርዔከ፡ ሰላም፡ ለወልደ፡ አምላክ፡ ሕይወቱ፨</l>
            <l n="3">ጰራቅሊጦስ፡ መድኅን፡ አድኅኖተ፡ ዓለም፡ ዘትፈቱ፨</l>
            <l n="4">አድኅነኒ፡ ወባልሐኒ፡ ከመ፡ ኢይጥፋዕ፡ በከንቱ፨</l>
            <l n="5">እምነ፡ ሰይጣን፡ ፀርየ፡ ዘጽኑዕ፡ መሥገርቱ፨</l>

          </lg>
          
          <lg type="stanza" n="11">
            
            <l n="1">ሰላም፡ ለክሣድከ፡ ወለመትከፍትከ፡ ረቅቅ፨</l>
            <l n="2">ወለዘባንከ፡ ሰላም፡ ግልቡበ፡ ነበልባል፡ መብረቅ፨</l>
            <l n="3">ጰራቅሊጦስ፡ ርግብ፡ ወጰራቅሊጦስ፡ ማዕነቅ፨</l>
            <l n="4">አንጽሐኒ፡ ወቀድሰኒ፡ ከመ፡ ቆርኔሌዎስ፡ ጻድቅ፨</l>
            <l n="5">ወበዮርዳኖስ፡ ዘቀደስኮ፡ ለዮሐንስ፡ ሊቅ፨</l>

          </lg>
          
          <lg type="stanza" n="12">
            
            <l n="1">ሰላም፡ ለእንግድዓከ፡ ዘቦቱ፡ ልምላሜ፨</l>
            <l n="2">ወለሕፅንከ፡ ሰላም፡ ዘይምዕዝ፡ እምአበሜ፨</l>
            <l n="3">ጰራቅሊጦስ፡ ጥንት፡ ዘአልብከ፡ ፍጻሜ፨</l>
            <l n="4">እስከ፡ እትመየጥ፡ መንገሌከ፡ ወሰከኒ፡ ዕድሜ፨</l>
            <l n="5">ወበኀቤከ፡ እረክብ፡ ሱላሜ፨</l>

          </lg>
          
          <lg type="stanza" n="13">
            
            <l n="1">ሰላም፡ ለአእዳዊከ፡ ዓለማተ፡ ኵሉ፡ ዘሣረሩ፨</l>
            <l n="2">ወለመዛርኢከ፡ ሰላም፡ ምስለ፡ ወላዲ፡ ወልድ፡ በኵሩ፨</l>
            <l n="3">ጰራቅሊጦስ፡ ስቴ፡ ለጴጥሮስ፡ በማኅበሩ፨</l>
            <l n="4">ወይነ፡ ትፍሥሕት፡ በዘኢይረስዕ፡ ግብሩ፨</l>
            <l n="5">እስመ፡ በስቴ፡ ሕይወት፡ አርድእት፡ ወንጌለ፡ መሀሩ፨</l>

          </lg>
          
          <lg type="stanza" n="14">
            
            <l n="1">ሰላም፡ ለኵርናዕከ፡ ኵርናዐ፡ ፍጡራን፡ ኢይሜሰሎ፨</l>
            <l n="2">ለእመትከ፡ ዓዲ፡ በሰማይ፡ ወበምድር፡ ዘሀሎ፨</l>
            <l n="3">ጰራቅሊጦስ፡ ኀያል፡ ለዕደ፡ ዓለም፡ እንተ፡ አብጠሎ፨</l>
            <l n="4">ዝርዎሙ፡ ለአፅራርየ፡ በነፋሰ፡ መዓት፡ ወአውሎ፨</l>
            <l n="5">ወውስተ፡ ገጸ፡ ምድር፡ ኢያትርፍ፡ ጸበሎ፨</l>

          </lg>
          
          <lg type="stanza" n="15">
            
            <l n="1">ሰላም፡ ለእራኅከ፡ ዓለማተ፡ ኵሉ፡ ጸባጢ፨</l>
            <l n="2">ወለአፃብዒከ፡ ሰላም፡ ለከርሠ፡ አርዮስ፡ ሰጣጢ፨</l>
            <l n="3">ጰራቅሊጦስ፡ እሳት፡ ዘወረድከ፡ በኢላሚጢ፨</l>
            <l n="4">ለጴጥሮስ፡ ሐዋርያ፡ ወለቆርኔሌዎስ፡ መያጢ፨</l>
            <l n="5">እምአምልኮ፡ አርጤምሰ፡ ዕብን፡ ወዜውስ፡ ዘኬጢ፨</l>

          </lg>
          
          <lg type="stanza" n="16">
            
            <l n="1">ሰላም፡ ለአጽፋረ፡ እዴከ፡ አጽፋረ፡ መለኮት፡ ነዲ፨</l>
            <l n="2">ወለገቦከ፡ ሰላም፡ ዘሠረፀ፡ እምሠርፀ፡ ወላዲ፨</l>
            <l n="3">ጰራቅሊጦስ፡ እግዚእ፡ ዘታብዕል፡ ወዘታነዲ፨</l>
            <l n="4">ለእመ፡ ክህደ፡ ሃይማኖተከ፡ ከሓዲ፨</l>
            <l n="5">ውስተ፡ ልበ፡ ምድር፡ ኀይልከ፡ ሰዳዲ፨</l>

          </lg>
          
          <lg type="stanza" n="17">
            
            <l n="1">ሰላም፡ ለከርሥከ፡ ወለልብከ፡ ስፉሕ፨</l>
            <l n="2">ወለኵልያቲከ፡ ሰላም፡ አምሳለ፡ አርዮብ፡ ብሩህ፨</l>
            <l n="3">ጰራቅሊጦስ፡ ቅሩብ፡ ለእለ፡ ሀለዉ፡ በንጽሕ፨</l>
            <l n="4">አንጽሐኒ፡ ወቀድሰኒ፡ በሥጋ፡ ክርስቶስ፡ ስቡሕ፨</l>
            <l n="5">ወምስለ፡ ደሙ፡ ክቡር፡ ዘሕብሩ፡ ቀይሕ፨</l>

          </lg>
          
          <lg type="stanza" n="18">
            
            <l n="1">ሰላም፡ ለሕሊናከ፡ ምስለ፡ ዘውጉ፨</l>
            <l n="2">ወለአማዑቲከ፡ ሰላም፡ አስካለ፡ ነበልባል፡ ኀረጉ፨</l>
            <l n="3">ጰራቅሊጦስ፡ ኢትፍልጠኒ፡ ለሥላሴከ፡ እምሕጉ፨</l>
            <l n="4">በእንተ፡ ፍቅርከ፡ እለ፡ ጣዕመ፡ ዓለም፡ ኀደጉ፨</l>
            <l n="5">ምስለ፡ መላእክት፡ ሰማየ፡ ዐረጉ፨</l>

          </lg>
          
          <lg type="stanza" n="19">
            
            <l n="1">ሰላም፡ ለንዋየ፡ ውስጥከ፡ ዘአልቦቱ፡ ዐመፃ፨</l>
            <l n="2">ወለኅንብርትከ፡ ሰላም፡ ዘመሰንቆ፡ ከርሥ፡ ድኅንፃ፨</l>
            <l n="3">ጰራቅሊጦስ፡ ምላዕ፡ ጥበበከ፡ ለሕሊናየ፡ ሕጸጻ፨</l>
            <l n="4">ወላዕለ፡ ፀርየዘቆመ፡ በኆፃ፨</l>
            <l n="5">አብህርት፡ መባርቅቲከ፡ ወፈኑ፡ አሕፃ፨</l>

          </lg>
          
          <lg type="stanza" n="20">
            
            <l n="1">ሰላም፡ ለሐቌከ፡ ሰይፈ፡ ቅድስና፡ ዘአጠቀ፨</l>
            <l n="2">ወለአቍያጺከ፡ ሰላም፡ ነበልባለ፡ እሳት፡ መብረቀ፨</l>
            <l n="3">ጰራቅሊጦስ፡ ሀበኒ፡ ዘእምኀቤከ፡ ጽድቀ፨</l>
            <l n="4">ወግበር፡ ለነፍስየ፡ መንግሥተ፡ ሰማያት፡ ምርፋቀ፨</l>
            <l n="5">ወበልብሰ፡ መርዓ፡ ኢትቁም፡ ዕራቀ፨</l>

          </lg>
          
          <lg type="stanza" n="21">
            
            <l n="1">ሰላም፡ እብል፡ ለአብራኪከ፡ መንበር፨</l>
            <l n="2">እለ፡ ልጹቃት፡ እማንቱ፡ ዘምስለ፡ አእጋር፨</l>
            <l n="3">ጰራቅሊጦስ፡ ማሕየዊ፡ እግዚአብሔር፨</l>
            <l n="4">አርእየኒ፡ መለኮተከ፡ ዘምስለ፡ ሥላሴ፡ ክቡር፨</l>
            <l n="5">ወውስተ፡ ቤትከ፡ ሰደኒ፡ በፍቅር፨</l>

          </lg>
          
          <lg type="stanza" n="22">
            
            <l n="1">ሰላም፡ ለሰኰናከ፡ ወለመከየድከ፡ ክልኤቲ፨</l>
            <l n="2">ዘኢይትባየጾን፡ ግብረ፡ መስሓቲ፨</l>
            <l n="3">ጰራቅሊጦስ፡ አድኅና፡ ለነፍስየ፡ ዛቲ፨</l>
            <l n="4">በዕለተ፡ ፍትሕ፡ አመ፡ ይነቅሕ፡ መዋቲ፨</l>
            <l n="5">ትትፈሣሕ፡ ብከ፡ ወትትሐሠይ፡ ባቲ፨</l>

          </lg>
          
          <lg type="stanza" n="23">
            
            <l n="1">ሰላም፡ ለአፃብዒከ፡ አፃብዐ፡ ክቡር፡ መለኮት፨</l>
            <l n="2">ለአጽፋሪከ፡ ሰላም፡ ወለቆምከ፡ ሕይወት፨</l>
            <l n="3">ጰራቅሊጦስ፡ እሳት፡ ዘወረድከ፡ በደብረ፡ ዘይት፨</l>
            <l n="4">ለጴጥሮስ፡ ሐዋርያ፡ ወለኵሎሙ፡ አርድእት፨</l>
            <l n="5">እምድኅረ፡ ትንሣኤሁ፡ ለወልድ፡ በኀምሳ፡ ዕለት፨</l>

          </lg>
          
          <lg type="stanza" n="24">
            
            <l n="1">ሰላም፡ ለመልክእከ፡ መልክአ፡ መለኮት፡ ኀያል፨</l>
            <l n="2">ዘኢይረክቦ፡ ኅሊና፡ ወኢይተረጐም፡ በቃል፨</l>
            <l n="3">ጰራቅሊጦስ፡ ሕይወት፡ መንጽሔ፡ አካል፨</l>
            <l n="4">ፄውወኒ፡ ከመ፡ ፄዋ፡ እምቀትለ፡ እዴሃ፡ ለሲኦል፨</l>
            <l n="5">ለክብረ፡ ሥላሴ፡ ገብርከ፡ በወልታ፡ ዘሣህል፨</l>

          </lg>
          
        </div>

        <div type="textpart" xml:id="tarafa-malke">
          
          <lg type="stanza" n="1">
            
            <l n="1">ስብሐት፡ ለከ፡ እግዚአብሔር፡ አብ፡ ማሕየዊ፨</l>
            <l n="2">ስብሐት፡ ለከ፡ እግዚአብሔር፡ ወልድ፡ ተፈናዊ፨</l>
            <l n="3">ስብሐት፡ ለከ፡ እግዚአብሔር፡ መንፈስ፡ ቅዱስ፡ ማሕየዊ፨</l>
            <l n="4">አድኅነኒ፡ አምላኪየ፡ እምእደ፡ እኩይ፡ ፀራዊ፨</l>
            <l n="5">ከመ፡ አድኀንኮ፡ እምፈርዖን፡ ለሙሴ፡ ዕብራዊ፨</l>

          </lg>
          
          <lg type="stanza" n="2">
            
            <l n="1">ሰላም፡ ለከ፡ ጰራቅሊጦስ፡ በዓለ፡ ፶፡ አምኃ፡ ሰላም፡ አቅረብኩ፨</l>
            <l n="2">በኢያእምሮ፡ ገበርኩ፨</l>
            <l n="3">በኢለብዎ፡ ኢትርግሙኒ፡ በዘኢይደሉ፡ ወስኩ፨</l>
            <l n="4">እስመ፡ ነደ፡ ልብየ፡ በፍቅሩ፡ ለ፲፻ወ፶፡ ድርሳን፡ በዝየ፡ ፈጸምኩ፨</l>

          </lg>
          
          <lg type="stanza" n="3">
            
            <l n="1">ኦጰራቅሊጦስ፡ መጥበቤ፡ አብዳን፨</l>
            <l n="2">ናዛዜ፡ ኅዙናን፡ ወመጽንዔ፡ ድኩማን፨</l>
            <l n="3">ረዳኤ፡ ምንዱባን፡ ወመጽድቄ፡ ኃጥኣን፨</l>
            <l n="4">ዕቀበኒ፡ እመሣግሪሁ፡ ለሰይጣን፨</l>
            <l n="5">ለገብርከ፡ ምስኪን፡ ጰራቅሊጦስ፡ ብርሃን፨</l>
            <l n="6">ወለኃጥእ፡ ገብርከ፡ ምኑን፡ አድኅነኒ፡ ዘልፈ፡ እመከራ፡ ዘመን፨</l>

          </lg>
          
        </div>
        
      </div>
    </body>
    
