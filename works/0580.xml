  <text>

    <body>
      <div type="edition" xml:lang="gez">

        

        <div type="textpart" xml:id="malke">
          
          <lg type="stanza" n="1">
            
            <l n="1">አውሎግሶን፡ አውሎግሶን፡ አውሎግሶን፡ ጌርዮስ፨</l>
            <l n="2">እንዘ፡ እብል፡ ሥልሰ፡ በስመ፡ ኢየሱስ፡ ክርስቶስ፨</l>
            <l n="3">አንቀጸ፡ መንግሥትከ፡ እቁም፡ ያሳይ፡ ንጉሥ፨</l>
            <l n="4">አርትዕ፡ እግረ፡ ልብየ፡ እምፅበሰ፡ ጌጋይ፡ መብዕስ፨</l>
            <l n="5">ማሕሌተ፡ መልክእከ፡ ለሰቢክ፡ በልሳን፡ ሐዲስ፨</l>

          </lg>
          
          <lg type="stanza" n="2">
            
            <l n="1">ሰላም፡ ለጸዋዔ፡ ስምከ፡ ዘሆህያቲሁ፡ ሠላስ፨</l>
            <l n="2">ከመ፡ ገጻተ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፨</l>
            <l n="3">ውዳሴ፡ መልክእከ፡ ኣንብብ፡ ያሳይ፡ ቀሲስ፨</l>
            <l n="4">ለከናፍርየ፡ በዘይነጽሕ፡ እምርኵስ፨</l>
            <l n="5">አልክፎ፡ በእዴከ፡ እምቍርባን፡ ቅዱስ፨</l>

          </lg>
          
          <lg type="stanza" n="3">
            
            <l n="1">ሰላም፡ ለሰማየ፡ ርእስከ፡ ወለሥዕርቲከ፡ ከዋክብቲሃ፨</l>
            <l n="2">ወለገጽከ፡ እብል፡ ሰላም፡ ምስለ፡ አምኃ፨</l>
            <l n="3">ያሳይ፡ መርዓዊ፡ እንተ፡ ትሠረገው፡ ንጽሐ፨</l>
            <l n="4">አርመመት፡ ባሕር፡ ተፈሢሓ፡ እንዘ፡ ተሐውር፡ ዲቤሃ፨</l>
            <l n="5">ወማዕበላኒ፡ ኪያከ፡ ሰብሐ፨</l>

          </lg>
          
          <lg type="stanza" n="20">
            
            <l n="1">ሰላም፡ ወአምኃ፡ ለመልክእከ፡ ኵሎን፨</l>
            <l n="2">እለ፡ ይጸድላ፡ በንጽሕ፡ እምነ፡ ከዋክብት፡ ጽዱላን፨</l>
            <l n="3">ያሳይ፡ ጴጥሮስ፡ በዓለ፡ መራኁት፡ ምእመን፨</l>
            <l n="4">አርኁ፡ ሊተ፡ እግዚኦ፡ አንቀጸ፡ ብርሃን፨</l>
            <l n="5">ዘበዊኦታ፡ ኢይክሉ፡ ዕልዋን፨</l>

          </lg>
          
          <lg type="stanza" n="21">
            
            <l n="1">ሰላም፡ ለተፈልጦትከ፡ ለፍትወተ፡ ሥጋ፡ እምዓለማ፨</l>
            <l n="2">ዓመታተ፡ ገድልከ፡ ያሳይ፡ ጊዜ፡ ተፈጸማ፨</l>
            <l n="3">ነፍስከ፡ ንጽሕት፡ አመ፡ ዐርገት፡ መልዕልተ፡ ራማ፨</l>
            <l n="4">በአክናፊሆሙ፡ ለኀይላተ፡ ክርስቶስ፡ ፌማ፨</l>
            <l n="5">መንክር፡ ግርማ፡ ኀይለ፡ ልዑል፡ ጸለላ፡ መንክር፡ ግርማ፨</l>

          </lg>
          
          <lg type="stanza" n="23">
            
            <l n="1">ሰላም፡ ለመቃብሪከ፡ በውሣጤ፡ ቅድስት፡ ደብተራሁ፨</l>
            <l n="2">ለመድኃኔ፡ ዓለም፡ ክርስቶስ፡ በፈለገ፡ መስቀል፡ ደመ፡ ገቦሁ፨</l>
            <l n="3">ለያዕቆብ፡ እስራኤል፡ እንተ፡ ያፈቅሮ፡ እኁኁ፨</l>
            <l n="4">ለወይነ፡ ፍቅርከ፡ ሶበ፡ ይትቀዳሕ፡ ዜናሁ፨</l>
            <l n="5">አልባበ፡ ትኩዛን፡ ሕዝበ፡ ያስተፌሥሕ፡ ናሁ፨</l>

          </lg>
          
          <lg type="stanza" n="24">
            
            <l n="1">ተወኪፈከ፡ ጸሎትየ፡ ከመ፡ ዕጣን፡ በቅድሜከ፨</l>
            <l n="2">ወማሕሌትየ፡ ንስቲተ፡ እንዘ፡ ኢትረሲ፡ በከ፨</l>
            <l n="3">ያሳይ፡ አዕርግ፡ ኀበ፡ አምላክከ፡</l>
            <l n="4">ወበለኒ፡ ለፍቁርከ፡ ሠመርኩ፡ ብከ፨</l>
            <l n="5">ወኪዳንየ፡ አቀውም፡ ምስሌከ፨</l>

          </lg>
          
        </div>

        <div type="textpart" xml:id="tarafa-malke">
          
          <lg type="stanza" n="1">
            
            <l n="1">ሰላም፡ ለከ፡ ሶበ፡ አደመኒ፡ ሊተ፡ ዜና፡ ገድሎሙ፡ እዜኑ፨</l>
            <l n="2">ዘጥዑም፡ ነገሩ፡ ወአዳም፡ ሥኑ፨</l>
            <l n="3">ለያሳይ፡ ወማኅበራኑ፨</l>

          </lg>
          
          <lg type="stanza" n="10">
            
            <l n="1">ሰላም፡ ለከ፡ ማሕፀንተ፡ ማርያም፡ ዮሐንስ፡ ወኢሳይያስ፡ ጻድቃን፨</l>
            <l n="2">እምፍትወተ፡ መብልዕ፡ ዘርሕቁ፡ ወእምስቴ፡ ወይን፨</l>
            <l n="3">አበው፡ ጸዋምያን፨</l>

          </lg>
          
          <lg type="stanza" n="11">
            
            <l n="1">ሰላም፡ ለክሙ፡ አጋእዝትየ፡ ጻድቃን፡ አምኃክሙ፡ አቅረብኩ፨</l>
            <l n="2">ፈጽሙ፡ ሊተ፡ ዘተመነይኩ፨</l>
            <l n="3">በጸሎትክሙ፡ እስመ፡ ተማሕፀንኩ፨</l>
            <l n="4">አንትሙ፡ ፍኖትየ፡ ባርኩ፡ ባርኩ፨</l>

          </lg>
          
        </div>
        
      </div>
    </body>
    
