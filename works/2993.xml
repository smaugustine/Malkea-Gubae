  <text>

    <body>
      <div type="edition" xml:lang="gez">

        

        <div type="textpart" xml:id="malke">
          
          <lg type="stanza" n="1">
            
            <l n="1">በስመ፡ እግዚአብሔር፡ ቀዳማዊ፡ ዘእንበለ፡ ትማልም፨</l>
            <l n="2">ወደኃራዊ፡ ዘእንበለ፡ ዮም፨</l>
            <l n="3">ወማዕከላዊ፡ ዘእንበለ፡ ጌሠም፨</l>
            <l n="4">ብሉየ፡ መዋዕል፡ ዘእንበለ፡ ዓም፨</l>
            <l n="5">ገባሬ፡ ኵሉ፡ ዘእንበለ፡ ድካም፨</l>
            <l n="6">ባሕረ፡ ምሕረት፡ ዘእንበለ፡ አቅም፨</l>
            <l n="7">ብሁተ፡ ሕሊና፡ እስከ፡ ለዓለም፨</l>

          </lg>
          
          <lg type="stanza" n="2">
            
            <l n="1">በስመ፡ እግዚአብሔር፡ ሥሉስ፡ ኅቡረ፡ ሀልዎ፨</l>
            <l n="2">እሳት፡ ዘኢይለክፍዎ፨</l>
            <l n="3">ኅቡዕ፡ ዘኢይሬእይዎ፨</l>
            <l n="4">ንጉሥ፡ ዘኢይሠይምዎ፨</l>
            <l n="5">እግዚእ፡ ዘኢያግዕዝዎ፨</l>

          </lg>
          
        </div>

        
        
