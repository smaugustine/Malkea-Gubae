  <text>

    <body>
      <div type="edition" xml:lang="gez">

        

        <div type="textpart" xml:id="malke">
          
          <lg type="stanza" n="1">
            
            <l n="1">በስመ፡ እግዚአብሔር፡ ዋሕድ፡ ወበሥላሴሁ፡ ቀዲሙ፨</l>
            <l n="2">ናሁ፡ ወጠንኩ፡ መልክኣተ፡ ግብሩ፡ ወስሙ፨</l>
            <l n="3">ለሊቀ፡ ጳጳሳት፡ ጴጥሮስ፡ ተፍጻሜተ፡ ሰማዕት፡ ኵሎሙ፨</l>
            <l n="4">ስባሔ፡ ወውዳሴ፡ ከመ፡ ይትናገር፡ በአቅሙ፨</l>
            <l n="5">አብርሂ፡ ልቡናየ፡ ማርሶሙ፨</l>

          </lg>
          
          <lg type="stanza" n="2">
            
            <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ እንተ፡ ጾርዎ፡ በኍልቁ፨</l>
            <l n="2">ጸወርተ፡ መንበር፡ ኪሩቤል፡ ለእግዚአብሔር፡ ደቁ፨</l>
            <l n="3">መሥዋዕተ፡ እቤል፡ ሜሌክ፡ ጴጥሮስ፡ ለባሕርየ፡ ዳዊት፡ ስንቁ፨</l>
            <l n="4">የሐይዉ፡ ብከ፡ ፍቁራን፡ ድኅረ፡ ተገድፉ፡ ወወድቁ፨</l>
            <l n="5">ወከመ፡ ግዝፈ፡ ምድረ፡ አጽራሮ፡ ዲበ፡ ምድር፡ ተሰጥቁ፨</l>

          </lg>
          
          <lg type="stanza" n="6">
            
            <l n="1">ሰላም፡ ለቀራንብቲከ፡ ዘአርአያሆን፡ አዳም፨</l>
            <l n="2">ወዘኢሰሀቦን፡ ንዋም፨</l>
            <l n="3">ብርሃነ፡ ማኅቶት፡ ጴጥሮስ፡ ዘእስክንድርያ፡ ተቅዋም፨</l>
            <l n="4">መልአ፡ በመካንከ፡ ፈለገ፡ ክሳድከ፡ ደም፨</l>
            <l n="5">አመ፡ በላዕሌከ፡ ዘንመ፡ ሰይፈ፡ ነድ፡ ዝናም፨</l>

          </lg>
          
          <lg type="stanza" n="11">
            
            <l n="1">ሰላም፡ ለአስናኒከ፡ ዘአርአያሆን፡ በረድ፨</l>
            <l n="2">ወለልሳንከ፡ ሰላም፡ ዘበአፈ፡ ኵሉ፡ ንዑድ፨</l>
            <l n="3">ስርናየ፡ በረከት፡ ጴጥሮስ፡ ዘእስክንድርያ፡ ምክያድ፨</l>
            <l n="4">ነፋስ፡ ኀይልከ፡ አመ፡ ይነፍሕ፡ በዐውድ፨</l>
            <l n="5">ተፈልጠ፡ እምኔከ፡ አርዮስ፡ ክርዳድ፨</l>

          </lg>
          
          <lg type="stanza" n="15">
            
            <l n="1">ሰላም፡ ለእንግድዓከ፡ ሥርጋዌ፡ ወራዙት፡ ዘኢረሰየ፨</l>
            <l n="2">ወለሕፅንከ፡ ሰላም፡ ዘጽጌ፡ በረከት፡ ጸገየ፨</l>
            <l n="3">ጳውሎስ፡ ጴጥሮስ፡ ዘተሰመይከ፡ ባሕርየ፨</l>
            <l n="4">ይቤለከ፡ ክርስቶስ፡ ከመ፡ ትጹር፡ ስምየ፨</l>
            <l n="5">ረሰይኩከ፡ ንዋየ፡ ኅሩየ፨</l>

          </lg>
          
          <lg type="stanza" n="19">
            
            <l n="1">ሰላም፡ ለአጽፋረ፡ እዴከ፡ አርአያሆን፡ ዘተወለጠ፨</l>
            <l n="2">ዘትሩፋቲከ፡ ጾም፡ እንዘ፡ ይሠቅዮን፡ ውስጠ፨</l>
            <l n="3">ሊቀ፡ ጵኣሳት፡ ጴጥሮስ፡ ድኅረ፡ መዊተ፡ ሰለጠ፨</l>
            <l n="4">ሰብአ፡ ግብጽ፡ መወልጣን፡ እለ፡ ለመዱ፡ ተውላጠ፨</l>
            <l n="5">ኢረከቡ፡ እንበሌሁ፡ ረድኤተ፡ ኅዳጠ፨</l>

          </lg>
          
          <lg type="stanza" n="23">
            
            <l n="1">ሰላም፡ ለኵልያቲከ፡ ሢመተ፡ አኪላስ፡ ዘመነኑ፨</l>
            <l n="2">በዘአመከሩ፡ ወአየኑ፨</l>
            <l n="3">ጴጥሮስ፡ ቀጸቦ፡ ለሰያፊሁ፡ በዐይኑ፨</l>
            <l n="4">እንዘ፡ ይብል፡ በአፉሁ፡ ወበልሳኑ፨</l>
            <l n="5">ዘኢይሬእያ፡ ለሞት፡ ወየሐዩ፡ መኑ፨</l>

          </lg>
          
          <lg type="stanza" n="28">
            
            <l n="1">ሰላምል፡ ለሐቌከ፡ በእሳተ፡ ቀዊሞ፡ ዘተፈትነ፨</l>
            <l n="2">በአፈ፡ ማእምራን፡ ሕዝብ፡ እስከ፡ ይሰመይ፡ ኀጺነ፨</l>
            <l n="3">ቀርነ፡ ሃይማኖት፡ ጴጥሮስ፡ ዘእስክንድርያ፡ እምነ፨</l>
            <l n="4">ዘበመንፈስ፡ ቅዱስ፡ ውሉድከ፡ ንሕነ፨</l>
            <l n="5">ብከ፡ ንወግዖሙ፡ ለኵሎሙ፡ ፀርነ፨</l>

          </lg>
          
          <lg type="stanza" n="32">
            
            <l n="1">ሰላም፡ ለመከየድከ፡ ዘአሳእነ፡ ወርቅ፡ ድልወቱ፨</l>
            <l n="2">ለለ፡ ዕለቱ፡ ወለለ፡ ሰዓቱ፨</l>
            <l n="3">ማኅፈደ፡ ሕዝቅያስ፡ ጴጥሮስ፡ ዘመዐርጊሁ፡ ፲ቱ፨</l>
            <l n="4">ኢወድቀ፡ አመ፡ ገፍዕዎ፡ ሠራዊተ፡ ዕልው፡ ከንቱ፨</l>
            <l n="5">እስመ፡ ዲበ፡ ኰኵሕ፡ ተሣረረ፡ ወተሐንጸ፡ ቦቱ፨</l>

          </lg>
          
          <lg type="stanza" n="40">
            
            <l n="1">ሰላም፡ ለትንሣኤ፡ ሥጋከ፡ በንፍሐተ፡ ቀርን፡ ረቂቅ፨</l>
            <l n="2">እመቃብሪሁ፡ እሙቅ፨</l>
            <l n="3">ዘጽሩየ፡ ምግባር፡ ኮንከ፡ ሊቀ፡ ጳጳሳት፡ ወርቅ፨</l>
            <l n="4">ዳኅፀ፡ ነፍስ፡ ኢይርከበኒ፡ ጊዜ፡ ድልቅልቅ፨<!Check spelling!></l>
            <l n="5">ሱቀኒ፡ ለገብርከ፡ እምግሩም፡ ወዲቅ፨</l>

          </lg>
          
          <lg type="stanza" n="41">
            
            <l n="1">ስብሐት፡ ይደሉ፡ ለአብ፡ አበ፡ ዓለማት፨</l>
            <l n="2">ወስብሐት፡ ለወልድ፡ ዘወለደነ፡ በጥምቀት፨</l>
            <l n="3">ወለመንፈስ፡ ቅዱስ፡ ጰራቅሊጦስ፡ ይደሉ፡ ስብሐት፨</l>
            <l n="4">ወስብሐት፡ ይደሉ፡ ለማርያም፡ ወላዲት፨</l>
            <l n="5">ዘአብርሀት፡ ልቡናየ፡ በኵሉ፡ ትምህርት፨</l>

          </lg>
          
        </div>

        
        
      </div>
    </body>
    
