  <text>

    <body>
      <div type="edition" xml:lang="gez">

        

        <div type="textpart" xml:id="malke">
          
          <lg type="stanza" n="1">
            
            <l n="1">በስመ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ፩አምላክ፨</l>
            <l n="2">ኣአምን፡ ዘንተ፡ ሥላሴ፡ በሰብሖ፨</l>
            <l n="3">ለዘይፃረረኒ፡ ተመኪሖ፨</l>
            <l n="4">ቃለ፡ እግዚአብሔር፡ ይንጽሖ፨</l>
            <l n="5">በሰይፈ፡ መለኮት፡ በሊሕ፡ ገቦሁ፡ ይፍጽሖ፨</l>

          </lg>
          
          <lg type="stanza" n="2">
            
            <l n="1">በስመ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ፩አምላክ፨</l>
            <l n="2">ኣአምን፡ ዘንተ፡ ሥላሴ፡ ዘምስለ፡ ተርጕሞ፨</l>
            <l n="3">ለዘይፃረረኒ፡ ተቃዊሞ፨</l>
            <l n="4">ቃለ፡ እግዚአብሔር፡ ያድክሞ፨</l>
            <l n="5">በሰይፈ፡ መለኮት፡ በሊሕ፡ ክሳዶ፡ ያግዝሞ፨</l>

          </lg>
          
          <lg type="stanza" n="15">
            
            <l n="1">በስመ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ፩አምላክ፨</l>
            <l n="2">ኣአምን፡ ዘንተ፡ ሥላሴ፡ እንበለ፡ አስህኮ፨</l>
            <l n="3">ለዘይፃረረኒ፡ ተሀዊኮ፨</l>
            <l n="4">ቃለ፡ እግዚአብሔር፡ ኢይምህኮ፨</l>
            <l n="5">በሰይፈ፡ መለኮት፡ ክሳዶ፡ ይብትኮ፨</l>

          </lg>
          
